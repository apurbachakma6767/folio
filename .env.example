# =============================================================================
# FOLIO - Hedera-Native Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# All values are for TESTNET first - migrate to mainnet after testing
# =============================================================================

# =============================================================================
# HEDERA (Primary Chain - Testnet)
# =============================================================================
# Your Hedera testnet operator account
# Get testnet credentials at: https://portal.hedera.com/
HEDERA_OPERATOR_ID=0.0.4866197
HEDERA_OPERATOR_KEY=3030020100300706052b8104000a0422042014d363bcd63d4b8249e336dfd164a25ab0fe9d98bce45f27f2ed0aca5775b212

# Hedera Network (testnet | mainnet | previewnet)
HEDERA_NETWORK=testnet

# Hedera RPC URLs (HashIO)
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
HEDERA_MAINNET_RPC_URL=https://mainnet.hashio.io/api

# =============================================================================
# HEDERA TOKEN IDs (Created during setup)
# =============================================================================
# These will be populated after deploying tokens on Hedera
# Mock stock tokens for testing
MOCK_AAPL_TOKEN_ID=0.0.xxxxx
MOCK_TSLA_TOKEN_ID=0.0.xxxxx

# Test USDC token (fungible token on Hedera)
USDC_TEST_TOKEN_ID=0.0.xxxxx

# Spend Note NFT collection
SPEND_NOTE_TOKEN_ID=0.0.xxxxx

# Hedera Consensus Service (HCS) topic for audit trail
AUDIT_TOPIC_ID=0.0.xxxxx

# =============================================================================
# COLLAR ORACLE (Hedera Smart Contract Service)
# =============================================================================
# Deployed CollarOracle contract on Hedera (HSCS)
# Will be populated after deployment
COLLAR_ORACLE_ADDRESS=0x0000000000000000000000000000000000000000

# =============================================================================
# FOLIO VAULT CONTRACT (Hedera Smart Contract Service)
# =============================================================================
# Deployed FolioVault contract on Hedera (HSCS)
# Will be populated after deployment
FOLIO_VAULT_CONTRACT_ID=0.0.xxxxx

# =============================================================================
# CHAINLINK CRE (Runtime Environment)
# =============================================================================
# CRE CLI private key for signing on-chain transactions
# 64-character hex, NO 0x prefix
# This is for the EVM-compatible Hedera chain (HSCS)
CRE_ETH_PRIVATE_KEY=your_hedera_evm_private_key_here_64_chars_no_0x

# Chainlink Data Streams API credentials
# Protected via Confidential HTTP — secrets stay in secure enclave
# Get credentials at: https://docs.chain.link/data-streams/getting-started
DATA_STREAMS_API_KEY=your_data_streams_api_key
DATA_STREAMS_HMAC_SECRET=your_hmac_secret
DATA_STREAMS_TIMESTAMP=auto

# =============================================================================
# DYNAMIC (Authentication & Embedded Wallets)
# =============================================================================
# Get from Dynamic Dashboard: https://app.dynamic.xyz/
NEXT_PUBLIC_DYNAMIC_ENV_ID=your_dynamic_environment_id
DYNAMIC_API_KEY=your_dynamic_api_key
DYNAMIC_API_TOKEN=your_dynamic_api_token
DYNAMIC_AUTH_TOKEN=your_dynamic_auth_token
DYNAMIC_DELEGATION_PRIVATE_KEY=your_delegation_key
DYNAMIC_ENVIRONMENT_ID=your_dynamic_environment_id
DYNAMIC_SERVER_WALLET_ADDRESS=0xYourServerWalletAddress
DYNAMIC_SERVER_WALLET_ID=your_server_wallet_id
DYNAMIC_WEBHOOK_SECRET=your_webhook_secret

# =============================================================================
# SUPABASE (Database & Backend)
# =============================================================================
# Get from Supabase Dashboard: https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# =============================================================================
# PINATA (IPFS for NFT Metadata)
# =============================================================================
# Get from Pinata: https://pinata.cloud/
PINATA_JWT=your_pinata_jwt_token
PINATA_API_KEY=your_pinata_api_key

# =============================================================================
# PLAID (Bank Account Linking)
# =============================================================================
# Get from Plaid Dashboard: https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox  # sandbox | development | production

# =============================================================================
# LITHIC (Virtual Cards)
# =============================================================================
# Get from Lithic: https://www.lithic.com/
LITHIC_API_KEY=your_lithic_api_key
LITHIC_ENV=sandbox  # sandbox | production
LITHIC_MOCK=true    # true for testing

# =============================================================================
# MINIMAX (AI Voice Agent)
# =============================================================================
# Get from MiniMax: https://www.minimaxi.com/
MINIMAX_API_KEY=your_minimax_api_key

# =============================================================================
# CRON (API Route Protection)
# =============================================================================
# Secret for protecting cron endpoints
CRON_SECRET=your_random_secret_string

# =============================================================================
# SWARM (Tesla Stock Token)
# =============================================================================
# Real Tesla token from Swarm Markets (mainnet only)
# SWARM_TSLA_TOKEN_ID=0.0.xxxxx

# =============================================================================
# DEPRECATED: BASE SEPOLIA (To be removed after Hedera migration)
# =============================================================================
# These are being phased out - do not use for new deployments
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# MOCK_USDC_BASE_ADDRESS=0xYourMockUSDCAddress
